+static void PS5_DrawTileRows(const PS5_DrawChunk *chunk)
+{
+    const size_t width = chunk->frame_width;
+    const size_t first_row = chunk->src_start;
+    const size_t last_row = chunk->src_end;
+
+    for (size_t y = first_row; y < last_row; y++) {
+        const size_t tile_y = y / PS5_TILE_HEIGHT;
+        const size_t local_y = y % PS5_TILE_HEIGHT;
+        const size_t src_row = y * width;
+        const size_t dst_tile_row = tile_y * width * PS5_TILE_HEIGHT;
+        const unsigned short *tile_offsets = PS5_tilemap[local_y];
+
+        /*
+         * Every four adjacent source pixels remain adjacent in the PS5 tile
+         * map. Keep source reads strictly row-major and copy each four-pixel
+         * run with one 16-byte operation.
+         */
+        for (size_t tile_x = 0; tile_x < width;
+             tile_x += PS5_TILE_WIDTH) {
+            const size_t copy_width =
+                SDL_min((size_t)PS5_TILE_WIDTH, width - tile_x);
+            const size_t dst_tile =
+                dst_tile_row +
+                (tile_x / PS5_TILE_WIDTH) * PS5_TILE_SIZE;
+            const uint32_t *source =
+                chunk->src + src_row + tile_x;
+            size_t local_x = 0;
+
+            for (; local_x + 4 <= copy_width; local_x += 4) {
+                SDL_memcpy(
+                    chunk->dst + dst_tile + tile_offsets[local_x],
+                    source + local_x,
+                    4 * sizeof(uint32_t));
+            }
+            for (; local_x < copy_width; local_x++) {
+                chunk->dst[dst_tile + tile_offsets[local_x]] =
+                    source[local_x];
+            }
+        }
+    }
+}

