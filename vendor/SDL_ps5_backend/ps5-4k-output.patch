+#define PS5_HLG_LUMA_BINS 64
+#define PS5_HLG_CODE_LEVELS 1024
+static int PS5_hlg_to_pq_lut[
+    PS5_HLG_LUMA_BINS * PS5_HLG_CODE_LEVELS];
+static pthread_once_t PS5_hlg_lut_once = PTHREAD_ONCE_INIT;
+
+static int PS5_Clamp10(int value)
+{
+    if (value < 0)
+        return 0;
+    if (value > 1023)
+        return 1023;
+    return value;
+}
+
+static double PS5_PqEncode(double normalized_luminance)
+{
+    const double m1 = 2610.0 / 16384.0;
+    const double m2 = 2523.0 / 32.0;
+    const double c1 = 3424.0 / 4096.0;
+    const double c2 = 2413.0 / 128.0;
+    const double c3 = 2392.0 / 128.0;
+    const double level =
+        pow(SDL_max(0.0, normalized_luminance), m1);
+    return pow((c1 + c2 * level) / (1.0 + c3 * level), m2);
+}
+
+static void PS5_InitializeHlgLuts(void)
+{
+    const double a = 0.17883277;
+    const double b = 0.28466892;
+    const double c = 0.55991073;
+    for (int luma_bin = 0;
+         luma_bin < PS5_HLG_LUMA_BINS;
+         luma_bin++) {
+        const double luma_signal =
+            ((double)luma_bin + 0.5) /
+            (double)PS5_HLG_LUMA_BINS;
+        const double scene_luminance =
+            luma_signal <= 0.5
+                ? luma_signal * luma_signal / 3.0
+                : (exp((luma_signal - c) / a) + b) / 12.0;
+        /*
+         * BT.2100 HLG OOTF for a 1000-nit reference display. The gain uses
+         * scene luminance. Approximate that shared gain from source luma in
+         * 64 bins; this keeps the 4K60 hot path to three integer table gathers
+         * while retaining each channel's full 10-bit input/output precision.
+         */
+        const double gain =
+            scene_luminance > 0.0
+                ? pow(scene_luminance, 0.2)
+                : 0.0;
+        for (int code = 0;
+             code < PS5_HLG_CODE_LEVELS;
+             code++) {
+            const double signal =
+                (double)code /
+                (double)(PS5_HLG_CODE_LEVELS - 1);
+            const double scene_component =
+                signal <= 0.5
+                    ? signal * signal / 3.0
+                    : (exp((signal - c) / a) + b) / 12.0;
+            const double display_component =
+                SDL_min(1.0, scene_component * gain);
+            PS5_hlg_to_pq_lut[
+                luma_bin * PS5_HLG_CODE_LEVELS + code] =
+                PS5_Clamp10((int)llround(
+                    PS5_PqEncode(display_component * 0.1) *
+                    1023.0));
+        }
+    }
+}
+
+int BFplayer_PS5_PrepareNativeHdrHlg(void)
+{
+    return pthread_once(
+        &PS5_hlg_lut_once,
+        PS5_InitializeHlgLuts);
+}
+
+static uint32_t PS5_ConvertBt2020Pixel(
+    int y_code,
+    int u_code,
+    int v_code,
+    int full_range)
+{
+    const int cb = u_code - 512;
+    const int cr = v_code - 512;
+    int red;
+    int green;
+    int blue;
+
+    if (full_range) {
+        red = (1024 * y_code + 1510 * cr + 512) >> 10;
+        green =
+            (1024 * y_code - 168 * cb - 585 * cr + 512) >> 10;
+        blue = (1024 * y_code + 1927 * cb + 512) >> 10;
+    } else {
+        const int luma = y_code - 64;
+        red = (1196 * luma + 1724 * cr + 512) >> 10;
+        green =
+            (1196 * luma - 192 * cb - 668 * cr + 512) >> 10;
+        blue = (1196 * luma + 2200 * cb + 512) >> 10;
+    }
+
+    return ((uint32_t)PS5_Clamp10(red) << 20) |
+           ((uint32_t)PS5_Clamp10(green) << 10) |
+           (uint32_t)PS5_Clamp10(blue);
+}
+
+static uint32_t PS5_ConvertHlgPackedToPq(
+    uint32_t packed,
+    int y_code,
+    int full_range)
+{
+    const int luma_bin = full_range
+        ? SDL_min(PS5_HLG_LUMA_BINS - 1,
+                  SDL_max(0, y_code) >> 4)
+        : SDL_min(
+              PS5_HLG_LUMA_BINS - 1,
+              SDL_max(
+                  0,
+                  ((y_code - 64) * PS5_HLG_LUMA_BINS +
+                   438) /
+                      876));
+    const int base = luma_bin * PS5_HLG_CODE_LEVELS;
+    return ((uint32_t)PS5_hlg_to_pq_lut[
+                base + ((packed >> 20) & 1023)] << 20) |
+           ((uint32_t)PS5_hlg_to_pq_lut[
+                base + ((packed >> 10) & 1023)] << 10) |
+           (uint32_t)PS5_hlg_to_pq_lut[
+               base + (packed & 1023)];
+}
+
+__attribute__((target("avx2")))
+static __m128i PS5_ConvertBt2020Four(
+    const uint16_t *y_samples,
+    const uint16_t *u_samples,
+    const uint16_t *v_samples,
+    int full_range,
+    int hlg_to_pq)
+{
+    const __m128i zero = _mm_setzero_si128();
+    const __m128i maximum = _mm_set1_epi32(1023);
+    __m128i y = _mm_cvtepu16_epi32(
+        _mm_loadl_epi64((const __m128i *)y_samples));
+    const __m128i y_codes = y;
+    const __m128i u = _mm_setr_epi32(
+        u_samples[0] & 1023,
+        u_samples[0] & 1023,
+        u_samples[1] & 1023,
+        u_samples[1] & 1023);
+    const __m128i v = _mm_setr_epi32(
+        v_samples[0] & 1023,
+        v_samples[0] & 1023,
+        v_samples[1] & 1023,
+        v_samples[1] & 1023);
+    const __m128i cb = _mm_sub_epi32(u, _mm_set1_epi32(512));
+    const __m128i cr = _mm_sub_epi32(v, _mm_set1_epi32(512));
+    __m128i red;
+    __m128i green;
+    __m128i blue;
+
+    if (full_range) {
+        red = _mm_add_epi32(
+            _mm_add_epi32(
+                _mm_mullo_epi32(y, _mm_set1_epi32(1024)),
+                _mm_mullo_epi32(cr, _mm_set1_epi32(1510))),
+            _mm_set1_epi32(512));
+        green = _mm_add_epi32(
+            _mm_add_epi32(
+                _mm_add_epi32(
+                    _mm_mullo_epi32(y, _mm_set1_epi32(1024)),
+                    _mm_mullo_epi32(cb, _mm_set1_epi32(-168))),
+                _mm_mullo_epi32(cr, _mm_set1_epi32(-585))),
+            _mm_set1_epi32(512));
+        blue = _mm_add_epi32(
+            _mm_add_epi32(
+                _mm_mullo_epi32(y, _mm_set1_epi32(1024)),
+                _mm_mullo_epi32(cb, _mm_set1_epi32(1927))),
+            _mm_set1_epi32(512));
+    } else {
+        y = _mm_sub_epi32(y, _mm_set1_epi32(64));
+        red = _mm_add_epi32(
+            _mm_add_epi32(
+                _mm_mullo_epi32(y, _mm_set1_epi32(1196)),
+                _mm_mullo_epi32(cr, _mm_set1_epi32(1724))),
+            _mm_set1_epi32(512));
+        green = _mm_add_epi32(
+            _mm_add_epi32(
+                _mm_add_epi32(
+                    _mm_mullo_epi32(y, _mm_set1_epi32(1196)),
+                    _mm_mullo_epi32(cb, _mm_set1_epi32(-192))),
+                _mm_mullo_epi32(cr, _mm_set1_epi32(-668))),
+            _mm_set1_epi32(512));
+        blue = _mm_add_epi32(
+            _mm_add_epi32(
+                _mm_mullo_epi32(y, _mm_set1_epi32(1196)),
+                _mm_mullo_epi32(cb, _mm_set1_epi32(2200))),
+            _mm_set1_epi32(512));
+    }
+
+    red = _mm_min_epi32(
+        maximum,
+        _mm_max_epi32(zero, _mm_srai_epi32(red, 10)));
+    green = _mm_min_epi32(
+        maximum,
+        _mm_max_epi32(zero, _mm_srai_epi32(green, 10)));
+    blue = _mm_min_epi32(
+        maximum,
+        _mm_max_epi32(zero, _mm_srai_epi32(blue, 10)));
+    if (hlg_to_pq) {
+        __m128i luma_bin;
+        if (full_range) {
+            luma_bin = _mm_srli_epi32(y_codes, 4);
+        } else {
+            /*
+             * 4789 / 65536 closely approximates 64 / 876. Clamp studio
+             * range before applying it so out-of-range samples stay safe.
+             */
+            luma_bin = _mm_srai_epi32(
+                _mm_add_epi32(
+                    _mm_mullo_epi32(
+                        _mm_max_epi32(
+                            zero,
+                            _mm_sub_epi32(
+                                y_codes,
+                                _mm_set1_epi32(64))),
+                        _mm_set1_epi32(4789)),
+                    _mm_set1_epi32(32768)),
+                16);
+        }
+        luma_bin = _mm_min_epi32(
+            _mm_set1_epi32(PS5_HLG_LUMA_BINS - 1),
+            _mm_max_epi32(zero, luma_bin));
+        const __m128i base = _mm_slli_epi32(luma_bin, 10);
+        red = _mm_i32gather_epi32(
+            PS5_hlg_to_pq_lut,
+            _mm_add_epi32(base, red),
+            sizeof(int));
+        green = _mm_i32gather_epi32(
+            PS5_hlg_to_pq_lut,
+            _mm_add_epi32(base, green),
+            sizeof(int));
+        blue = _mm_i32gather_epi32(
+            PS5_hlg_to_pq_lut,
+            _mm_add_epi32(base, blue),
+            sizeof(int));
+    }
+
+    return _mm_or_si128(
+        _mm_or_si128(
+            _mm_slli_epi32(red, 20),
+            _mm_slli_epi32(green, 10)),
+        blue);
+}
+
+typedef struct BFplayer_OverlayBlend {
+    unsigned int inverse_alpha;
+    unsigned int red;
+    unsigned int green;
+    unsigned int blue;
+    uint32_t packed;
+    int active;
+} BFplayer_OverlayBlend;
+
+static BFplayer_OverlayBlend PS5_PrepareSdrOverlay(uint32_t overlay)
+{
+    BFplayer_OverlayBlend blend;
+    const unsigned int alpha = overlay >> 24;
+    unsigned int pq_red;
+    unsigned int pq_green;
+    unsigned int pq_blue;
+
+    blend.inverse_alpha = 255 - alpha;
+    blend.active = alpha != 0;
+    /*
+     * Place opaque SDR UI white at approximately 100 nits in the native PQ
+     * signal. Blending in code space is deliberate here: it keeps this hot
+     * per-pixel overlay path bounded while preserving readable antialiasing.
+     */
+    pq_red = ((overlay & 255) * 520 + 127) / 255;
+    pq_green = (((overlay >> 8) & 255) * 520 + 127) / 255;
+    pq_blue = (((overlay >> 16) & 255) * 520 + 127) / 255;
+    blend.red = (pq_red * alpha + 127) / 255;
+    blend.green = (pq_green * alpha + 127) / 255;
+    blend.blue = (pq_blue * alpha + 127) / 255;
+    blend.packed = (blend.red << 20) | (blend.green << 10) | blend.blue;
+    return blend;
+}
+
+static uint32_t PS5_ApplySdrOverlay(
+    uint32_t video,
+    const BFplayer_OverlayBlend *blend)
+{
+    unsigned int video_red;
+    unsigned int video_green;
+    unsigned int video_blue;
+
+    if (!blend->active)
+        return video;
+    if (blend->inverse_alpha == 0)
+        return blend->packed;
+    video_red =
+        ((((video >> 20) & 1023) * blend->inverse_alpha + 127) / 255) +
+        blend->red;
+    video_green =
+        ((((video >> 10) & 1023) * blend->inverse_alpha + 127) / 255) +
+        blend->green;
+    video_blue =
+        (((video & 1023) * blend->inverse_alpha + 127) / 255) +
+        blend->blue;
+    return (video_red << 20) | (video_green << 10) | video_blue;
+}
+
+static void PS5_DrawTileRows(const BFplayer_TileWork *chunk)
+{
+    const size_t width = chunk->frame_width;
+    const size_t first_row = chunk->first_row;
+    const size_t last_row = chunk->last_row;
+    const int exact_yuv_layout =
+        chunk->y_plane != NULL &&
+        chunk->source_x == 0 &&
+        chunk->source_y == 0 &&
+        chunk->source_width == width &&
+        chunk->source_height == chunk->frame_height &&
+        chunk->destination_x == 0 &&
+        chunk->destination_y == 0 &&
+        chunk->destination_width == width &&
+        chunk->destination_height == chunk->frame_height;
+
+    for (size_t y = first_row; y < last_row; y++) {
+        const size_t tile_y = y / PS5_TILE_HEIGHT;
+        const size_t local_y = y % PS5_TILE_HEIGHT;
+        const size_t dst_tile_row = tile_y * width * PS5_TILE_HEIGHT;
+        const unsigned short *tile_offsets = PS5_tilemap[local_y];
+        const uint16_t *y_row = NULL;
+        const uint16_t *u_row = NULL;
+        const uint16_t *v_row = NULL;
+        const uint32_t *overlay_row = NULL;
+        uint32_t cached_overlay = 0;
+        BFplayer_OverlayBlend cached_blend;
+        int have_cached_overlay = 0;
+        size_t src_row = 0;
+
+        if (chunk->y_plane != NULL && exact_yuv_layout) {
+            y_row = chunk->y_plane + y * chunk->y_pitch_samples;
+            u_row = chunk->u_plane + (y / 2) * chunk->u_pitch_samples;
+            v_row = chunk->v_plane + (y / 2) * chunk->v_pitch_samples;
+        } else {
+            src_row = y * chunk->source_pitch_pixels;
+        }
+        if (chunk->y_plane != NULL && chunk->overlay != NULL) {
+            size_t mapped_overlay_y;
+            if (chunk->overlay_height == chunk->frame_height)
+                mapped_overlay_y = y;
+            else if (chunk->overlay_height * 2 == chunk->frame_height)
+                mapped_overlay_y = y / 2;
+            else
+                mapped_overlay_y =
+                    y * chunk->overlay_height / chunk->frame_height;
+            if (mapped_overlay_y >= chunk->overlay_y &&
+                mapped_overlay_y <
+                    chunk->overlay_y +
+                    chunk->overlay_region_height) {
+                overlay_row =
+                    chunk->overlay +
+                    mapped_overlay_y * chunk->overlay_pitch_pixels;
+            }
+        }
+
+        /*
+         * Every four adjacent source pixels remain adjacent in the PS5 tile
+         * map. Keep source reads strictly row-major and copy each four-pixel
+         * run with one 16-byte operation.
+         */
+        for (size_t tile_x = 0; tile_x < width;
+             tile_x += PS5_TILE_WIDTH) {
+            const size_t copy_width =
+                SDL_min((size_t)PS5_TILE_WIDTH, width - tile_x);
+            const size_t dst_tile =
+                dst_tile_row +
+                (tile_x / PS5_TILE_WIDTH) * PS5_TILE_SIZE;
+            size_t local_x = 0;
+
+            if (chunk->y_plane != NULL && !exact_yuv_layout) {
+                for (; local_x < copy_width; local_x++) {
+                    const size_t output_x = tile_x + local_x;
+                    uint32_t converted = 0;
+                    const int inside_video =
+                        y >= chunk->destination_y &&
+                        y < chunk->destination_y +
+                                chunk->destination_height &&
+                        output_x >= chunk->destination_x &&
+                        output_x < chunk->destination_x +
+                                chunk->destination_width;
+                    if (inside_video) {
+                        size_t source_x =
+                            chunk->source_x +
+                            (output_x - chunk->destination_x) *
+                                chunk->source_width /
+                                chunk->destination_width;
+                        size_t source_y =
+                            chunk->source_y +
+                            (y - chunk->destination_y) *
+                                chunk->source_height /
+                                chunk->destination_height;
+                        const size_t source_x_limit =
+                            chunk->source_x + chunk->source_width - 1;
+                        const size_t source_y_limit =
+                            chunk->source_y + chunk->source_height - 1;
+                        if (source_x > source_x_limit)
+                            source_x = source_x_limit;
+                        if (source_y > source_y_limit)
+                            source_y = source_y_limit;
+                        converted = PS5_ConvertBt2020Pixel(
+                            chunk->y_plane[
+                                source_y * chunk->y_pitch_samples +
+                                source_x] &
+                                1023,
+                            chunk->u_plane[
+                                (source_y / 2) *
+                                    chunk->u_pitch_samples +
+                                source_x / 2] &
+                                1023,
+                            chunk->v_plane[
+                                (source_y / 2) *
+                                    chunk->v_pitch_samples +
+                                source_x / 2] &
+                                1023,
+                            chunk->full_range);
+                        if (chunk->hlg_to_pq) {
+                            converted =
+                                PS5_ConvertHlgPackedToPq(
+                                    converted,
+                                    chunk->y_plane[
+                                        source_y *
+                                            chunk->y_pitch_samples +
+                                        source_x] &
+                                        1023,
+                                    chunk->full_range);
+                        }
+                    }
+                    if (overlay_row != NULL) {
+                        size_t mapped_overlay_x;
+                        if (chunk->overlay_width == width)
+                            mapped_overlay_x = output_x;
+                        else if (chunk->overlay_width * 2 == width)
+                            mapped_overlay_x = output_x / 2;
+                        else
+                            mapped_overlay_x =
+                                output_x * chunk->overlay_width / width;
+                        if (mapped_overlay_x >= chunk->overlay_x &&
+                            mapped_overlay_x <
+                                chunk->overlay_x +
+                                chunk->overlay_region_width) {
+                            const uint32_t overlay =
+                                overlay_row[mapped_overlay_x];
+                            if (!have_cached_overlay ||
+                                overlay != cached_overlay) {
+                                cached_overlay = overlay;
+                                cached_blend =
+                                    PS5_PrepareSdrOverlay(overlay);
+                                have_cached_overlay = 1;
+                            }
+                            converted = PS5_ApplySdrOverlay(
+                                converted,
+                                &cached_blend);
+                        }
+                    }
+                    chunk->dst[
+                        dst_tile + tile_offsets[local_x]] = converted;
+                }
+            } else if (y_row != NULL) {
+                if (overlay_row == NULL) {
+                    for (; local_x + 4 <= copy_width;
+                         local_x += 4) {
+                        const size_t source_x =
+                            tile_x + local_x;
+                        const __m128i converted =
+                            PS5_ConvertBt2020Four(
+                                y_row + source_x,
+                                u_row + source_x / 2,
+                                v_row + source_x / 2,
+                                chunk->full_range,
+                                chunk->hlg_to_pq);
+                        _mm_storeu_si128(
+                            (__m128i *)(
+                                chunk->dst +
+                                dst_tile +
+                                tile_offsets[local_x]),
+                            converted);
+                    }
+                    for (; local_x < copy_width;
+                         local_x++) {
+                        const size_t source_x =
+                            tile_x + local_x;
+                        chunk->dst[
+                            dst_tile + tile_offsets[local_x]] =
+                            PS5_ConvertBt2020Pixel(
+                                y_row[source_x] & 1023,
+                                u_row[source_x / 2] & 1023,
+                                v_row[source_x / 2] & 1023,
+                                chunk->full_range);
+                        if (chunk->hlg_to_pq) {
+                            chunk->dst[
+                                dst_tile + tile_offsets[local_x]] =
+                                PS5_ConvertHlgPackedToPq(
