+static void PS5_DrawPixelsAsTilesPitched(const uint32_t *src, uint32_t *dst,
+                                         int frame_width, int frame_height,
+                                         size_t source_pitch_pixels)
+{
+    if (!PS5_tile_workers.ready) {
+        BFplayer_TileWork fallback = {
+            src, dst, (size_t)frame_width, (size_t)frame_height,
+            source_pitch_pixels, 0, (size_t)frame_height
+        };
+        PS5_DrawTileRows(&fallback);
+        return;
+    }
+
+    pthread_mutex_lock(&PS5_tile_workers.mutex);
+    PS5_tile_workers.completed = 0;
+    for (int i = 0; i < PS5_THREAD_COUNT; i++) {
+        BFplayer_TileWork *chunk = &PS5_tile_workers.chunks[i];
+        chunk->src = src;
+        chunk->dst = dst;
+        chunk->frame_width = (size_t)frame_width;
+        chunk->frame_height = (size_t)frame_height;
+        chunk->source_pitch_pixels = source_pitch_pixels;
+        chunk->y_plane = NULL;
+        chunk->u_plane = NULL;
+        chunk->v_plane = NULL;
+        chunk->overlay = NULL;
+        chunk->first_row =
+            (size_t)frame_height * (size_t)i / PS5_THREAD_COUNT;
+        chunk->last_row =
+            (size_t)frame_height * (size_t)(i + 1) / PS5_THREAD_COUNT;
+    }
+    PS5_tile_workers.generation++;
+    pthread_cond_broadcast(&PS5_tile_workers.work_ready);
+    while (PS5_tile_workers.completed < PS5_THREAD_COUNT)
+        pthread_cond_wait(&PS5_tile_workers.work_done,
+                          &PS5_tile_workers.mutex);
+    pthread_mutex_unlock(&PS5_tile_workers.mutex);
+}
